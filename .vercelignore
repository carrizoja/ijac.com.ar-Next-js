# Local agent-tooling artifacts. These are ignored by a global gitignore, so they
# never appear as untracked, but Vercel CLI uploads walk the working directory and
# only honour this file. .codegraph holds a Unix socket that aborts the upload.
.codegraph
.atl
.pi
.agents
.claude

# Build output of the website, which this project does not deploy.
.next
out
node_modules

# Test sources. Vercel typechecks every file it receives, so a spec importing vitest becomes a
# build error in a package that has no test runner installed. They are not runtime code either.
**/*.test.ts
**/*.test.tsx
**/testing/
